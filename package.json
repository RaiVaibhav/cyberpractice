{
  "name": "cyberpractice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local practice range for LLM/AppSec attack scenarios. Each folder is a scenario; the platform boots a vulnerable target app for it.",
  "scripts": {
    "scenario": "node platform/cli.js",
    "start": "node platform/cli.js",
    "free": "node platform/cli.js --free",
    "real": "node platform/cli.js --real",
    "dev": "node platform/cli.js --dev",
    "list": "node platform/cli.js --list",
    "new": "node platform/new-scenario.js",
    "build:ui": "vite build",
    "dev:ui": "vite",
    "py:setup": "python3 -m venv .venv && .venv/bin/pip install -r backend/requirements.txt",
    "py": ".venv/bin/python -m backend.run",
    "py:free": ".venv/bin/python -m backend.run --free"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "vite": "^5.4.11"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.70.0"
  }
}
