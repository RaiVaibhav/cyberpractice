# Copy to .env and fill in. .env is git-ignored. Used by `npm run free`.

# Which free real-model provider to use with --free.
# Options: ollama (default, local, no key) | groq | openrouter | gemini
CYBERPRACTICE_FREE=groq

# API key for the chosen hosted provider (NOT needed for local ollama).
# Groq is free with no card: https://console.groq.com  → API Keys → Create.
GROQ_API_KEY=gsk_your_key_here

# --- optional overrides ---
# CYBERPRACTICE_FREE_MODEL=openai/gpt-oss-20b   # pick a specific model
# CYBERPRACTICE_FREE_BASE_URL=                  # point --free at any OpenAI-compatible server
# CYBERPRACTICE_FREE_KEY=                        # key for a custom base URL
# ANTHROPIC_API_KEY=                             # only for --real (live Claude)
